# Copy to .env and adjust. The server reads plain environment variables,
# so load this file with `set -a; source .env; set +a` or use `make run`.

# Required outside of development. Use at least 32 random bytes, e.g.
#   openssl rand -base64 48
JWT_SECRET=dev-secret-do-not-use-in-production-0123456789

# development | production
APP_ENV=development

PORT=8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=restgo
